{
  "name": "sand-cheats",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/inject-crawl-content.mjs && node scripts/generate-sitemap.mjs && tsc -b && vite build && node scripts/verify-seo-body.mjs && node scripts/verify-redirects.mjs",
    "deploy": "npm run build && wrangler deploy --keep-vars",
    "pages:build": "npm run build",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=sandcheats"
  },
  "dependencies": {
    "@types/react-router-dom": "^5.3.3",
    "lenis": "^1.3.23",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "sharp": "^0.35.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "wrangler": "^4.110.0"
  }
}
